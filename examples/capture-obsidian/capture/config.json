{
  "scan": {
    "root": "~/Captures",
    "index_file": "index.json"
  },
  "obsidian": {
    "vault": "~/Vaults/personal",
    "daily": {
      "note": "00 Daily Log/{{.Year}}/{{.Date}}.md",
      "section": "Captured{{with .Device}} - {{.}}{{end}}",
      "images": {
        "folder": "assets/{{.Note}}",
        "max_side": 2048,
        "quality": 80
      }
    },
    "timelines": "99 Toolkit/timelines.json"
  }
}
