{{- /*
  One instance, one process, one endpoint: `listen` is a port on this machine
  and `remote` is the hop that follows it, which dgs resolved from the route.
  Replacing the machine at the far end changes that route's hops and nothing
  here.
*/ -}}
[log]
level = {{ toJSON $.log_level }}

[network]
use_udp = {{ $.use_udp }}
use_tcp = {{ $.use_tcp }}

{{ range $name, $number := (instance).ports -}}
[[endpoints]]
listen = {{ printf "%s:%v" (or (instance).bind "0.0.0.0") $number | toJSON }}
remote = {{ printf "%s:%v" (upstream).address (upstream).port | toJSON }}
{{ end -}}
