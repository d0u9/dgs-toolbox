{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dgs:capture:index:v1",
  "title": "DGS Capture Index v1",
  "description": "Metadata contract for a v1 DGS Capture directory. Fields not described here are ignored.",
  "type": "object",
  "required": [
    "schema",
    "source",
    "id",
    "createdAt"
  ],
  "properties": {
    "schema": {
      "const": "v1"
    },
    "source": {
      "type": "object",
      "description": "The application that executed the capture workflow, for example Shortcuts.",
      "required": [
        "app",
        "workflow",
        "device"
      ],
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1,
          "description": "The producing workflow, for example note or photo_note."
        },
        "device": {
          "type": "object",
          "required": [
            "os",
            "systemVersion",
            "name"
          ],
          "properties": {
            "os": {
              "type": "string",
              "minLength": 1
            },
            "systemVersion": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coordinates": {
      "type": "object",
      "required": [
        "altitude",
        "longitude",
        "latitude"
      ],
      "properties": {
        "altitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      },
      "additionalProperties": false,
      "description": "Numeric location. Optional; descriptive location lives in place."
    },
    "place": {
      "type": "object",
      "description": "Descriptive location. Every field is optional; a present field must be a non-empty string.",
      "properties": {
        "locality": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
